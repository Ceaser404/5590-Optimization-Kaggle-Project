_decay)\n","        super(SGDMomentum, self).__init__(params, defaults)\n","\n","    def step(self, closure=None):\n","        V = [];\n","        for group in self.param_groups:\n","            weight_decay = group['weight_decay']\n","\n","            for param in group['params']:\n","                if param.grad is None:\n","                    continue\n","                state = self.state[param]\n","                if 'momentum_buffer' not in state:\n","                        state['momentum_buffer'] = torch.zeros_like(param.data)\n","                V = state['momentum_buffer']\n","\n","                grad_param = param.grad.data\n","\n","                if weight_decay != 0:\n","                    grad_param += weight_decay*param.data\n","                V = V*group['momentum'] + (1-group['momentum'])*grad_param\n","\n","                param.data -= group['lr']*grad_param\n","\n","        return loss"],"metadata":{"papermill":{"duration":0.032868,"end_time":"2021-04-28T20:52:08.185517","exception":false,"start_time":"2021-04-28T20:52:08.152649","status":"completed"},"tags":[],"execution":{"iopub.status.busy":"2025-12-11T22:19:16.510886Z","iopub.execute_input":"2025-12-11T22:19:16.511421Z","iopub.status.idle":"2025-12-11T22:19:16.519427Z","shell.execute_reply.started":"2025-12-11T22:19:16.511398Z","shell.execute_reply":"2025-12-11T22:19:16.518729Z"},"trusted":true,"id":"_hfRcjT7iAxz","executionInfo":{"status":"ok","timestamp":1765951151772,"user_tz":360,"elapsed":5,"user":{"displayName":"Roman Hunter","userId":"04599973894551074078"}}},"outputs":[],"execution_count":26},{"cell_type":"markdown","source":["## Final project: add a schedular"],"metadata":{"id":"7Ue0rgvkiAxz"}},{"cell_type":"code","source":["from torch.optim.lr_scheduler import ReduceLROnPlateau, _LRScheduler\n","\n","class MinimalScheduler(_LRScheduler):\n","    def __init__(self,\n","                 optimizer,\n","                 last_epoch=-1):\n","        \"\"\"\n","        Implements a 