org/docs/1.9.0/optim.html?highlight=sgd#torch.optim.SGD)\n","\n","Please refer to the final project page to see requirements of the implementation of a customized optimizer."],"metadata":{"papermill":{"duration":0.021728,"end_time":"2021-04-28T20:52:08.085228","exception":false,"start_time":"2021-04-28T20:52:08.0635","status":"completed"},"tags":[],"id":"kFmIMHGOiAxz"}},{"cell_type":"code","source":["from torch.optim import Optimizer\n","import math # Need this import for the step function\n","\n","class Adam(Optimizer): # Assuming you named your class Adam\n","    def __init__(self,\n","                 params,\n","                 lr=1e-3,           # Lowered the default LR\n","                 betas=(0.9, 0.999), # Use the standard PyTorch tuple for beta1 and beta2\n","                 eps=1e-8,\n","                 weight_decay=0.0):\n","\n","        # Check that betas is a tuple or list of two elements\n","        if not isinstance(betas, (list, tuple)) or len(betas) != 2:\n","            raise ValueError(\"betas must be a tuple/list of two elements (beta1, beta2)\")\n","\n","        defaults = dict(lr=lr,\n","                        betas=betas, # <-- The step function reads 'betas' here\n","                        eps=eps,\n","                        weight_decay=weight_decay)\n","        super().__init__(params, defaults)\n","\n","    def step(self, closure=None):\n","        loss = None\n","        for group in self.param_groups:\n","            for p in group['params']:\n","                if p.grad is None:\n","                    continue\n","                grad = p.grad\n","                state = self.state[p]\n","\n","                # State initialization\n","                if len(state) == 0:\n","                    state['step'] = 0\n","                    state['exp_avg'] = torch.zeros_like(p)\n","                    state['exp_avg_sq'] = torch.zeros_like(p)\n","\n","                exp_avg, exp_avg_sq = state['exp_avg'], state['exp_avg_sq']\n","                beta1, beta2 = group['betas']\n","\n","                state['step'] += 1\n","\n","                exp_avg.mul_(beta1).add_(grad, alpha=1 - beta1)\n","                exp_avg_sq.mul_(beta2).addcmul_(grad, grad, value=1 - beta2)\n","\n","                denom = exp_avg_sq.sqrt().add_(group['eps'])\n","\n","                correction1 = 1 - beta1**state['step']\n","                correction2 = 1 - beta2**state['step']\n","                step_size = group['lr'] * math.sqrt(correction2) / correction1\n","                # correction2 is a float thus math.sqrt is used\n","\n","                p.data.addcdiv_(exp_avg, denom, value=-step_size)\n","        return loss"],"metadata":{"papermill":{"duration":0.032868,"end_time":"2021-04-28T20:52:08.185517","exception":false,"start_time":"2021-04-28T20:52:08.152649","status":"completed"},"tags":[],"execution":{"iopub.status.busy":"2025-12-11T22:19:16.510886Z","iopub.execute_input":"2025-12-11T22:19:16.511421Z","iopub.status.idle":"2025-12-11T22:19:16.519427Z","shell.execute_reply.started":"2025-12-11T22:19:16.511398Z","shell.execute_reply":"2025-12-11T22:19:16.518729Z"},"trusted":true,"id":"_hfRcjT7iAxz"},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":["## Final project: add a schedular"],"metadata":{"id":"7Ue0rgvkiAxz"}},{"cell_type":"code","source":["from torch.optim.lr_scheduler import ReduceLROnPlateau, _LRScheduler\n","\n","class MinimalScheduler(_LRScheduler):\n","    def __init__(self,\n","                 optimizer,\n","                 last_epoch=-1):\n","        \"\"\"\n","        Implements a minimal learning rate scheduler\n","        \"\"\"\n","        super().__init__(optimizer, last_epoch)\n","\n","    def get_lr(self):\n","        # Implement your logic here to return a list of learning rates for each param group\n","        # Example: return [group['lr'] * 0.9 for group in self.optimizer.param_groups]\n","        return [group['lr'] for group in self.optimizer.param_gro