 [0.0] # list the accuracy on validation dataset\n","    acc_max = 0.0 # current maximum accuracy\n","\n","    with tqdm(total=len(train_loader)) as pbar:\n","        for x, targets in train_loader:\n","\n","            x, targets = x.to(device), targets.to(device)\n","            outputs = model(x)# forward pass\n","            loss = loss_func(outputs, targets)# loss function\n","            loss_vals.append(loss.item())# record loss function values\n","            optimizer.zero_grad()# clean the gradient from last iteration\n","            loss.backward()# backprop\n","            optimizer.step()# gradient descent\n","            # some schedulers can be called, OneCycleLR\n","            # Record metrics\n","            loss_vals.append(loss.item())\n","            with torch.no_grad():\n","                preds = outputs.argmax(dim=-1)\n","                batch_acc = (preds == targets).float().mean().item()\n","                train_acc_accum.append(batch_acc)\n","\n","            pbar.set_postfix({\n","                'loss': f\"{np.mean(loss_vals):.4f}\",\n","                'tr_acc': f\"{np.mean(train_acc_accum):.4f}\"\n","            })\n","            pbar.update()\n","            #desc = f\"epoch: [{epoch+1}/{epochs}] | loss: {np.mean(loss_vals):.4e}\"\n","            #desc += f\"| acc on valid: {acc_last_epoch:.4f}\"\n","            #pbar.set_description(desc)\n","            #pbar.update()\n","\n","    # record the train losses\n","    avg_train_loss = np.mean(loss_vals)\n","    avg_train_acc = np.mean(train_acc_accum)\n","    train_losses.append(np.mean(loss_vals))\n","\n","\n","    # check accuracy (simple validation)\n","    val_loss_epoch = []\n","    with torch.no_grad():\n","        for x_v, y_v in val_loader:\n","            # x_v: validation image\n","            # y_v: validation target\n","            x_v, y_v = x_v.to(device), y_v.to(device)\n","            yhat = model(x_v) # yhat is (batch_size, 10)\n","\n","            # Calculate valida