" to that\n","        param.requires_grad = False\n","\n","# --- 2. Re-create AdaDelta ---\n","# We only pass the parameters that are NOT frozen\n","optimizer = torch.optim.Adadelta(\n","    filter(lambda p: p.requires_grad, model.parameters()),\n","    lr=1.0,\n","    rho=0.95,\n","    eps=1e-6\n",")\n","\n","# --- 3. Refinement Loop (3 Epochs on val_loader) ---\n","model.train()\n","prev_loss = float('inf')\n","\n","for epoch in range(3):\n","    epoch_losses = []\n","\n","    # We use the val_loader you already created\n","    pbar = tqdm(val_loader, desc=f\"Refining on Validation Data - Epoch {epoch+1}\")\n","\n","    for x, y in pbar:\n","        x, y = x.to(device), y.to(device)\n","\n","        optimizer.zero_grad()\n","\n","        # Standard forward/backward\n","        outputs = model(x)\n","        loss = nn.CrossEntropyLoss()(outputs, y)\n","        loss.backward()\n","        optimizer.step()\n","\n","        epoch_losses.append(loss.item())\n","        pbar.set_postfix(loss=f\"{loss.item():.4f}\")\n","\n","    avg_loss = np.mean(epoch_losses)\n","    print(f\"Epoch {epoch+1} Complete. Avg Loss: {avg_loss:.4f}\")\n","\n","    # --- 4. Safety Brake ---\n","    if avg_loss > prev_loss:\n","        print(\"⚠️ Stopping early: Loss is no longer improving. Keeping current weights.\")\n","        break\n","    prev_loss = avg_loss\n","\n","# --- 5. Save ---\n","torch.save(model.state_dict(), \"model_refined_on_val.pt\")\n","print(\"Done. Refined model saved.\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"4HNPNkdfLXIK","executionInfo":{"status":"ok","timestamp":1766263146961,"user_tz":360,"elapsed":5925,"user":{"displayName":"Roman Hunter","userId":"04599973894551074078"}},"outputId":"34fb5ed3-691a-4cc4-8058-b54c689bc0e2"},"execution_count":18,"outputs":[{"output_type":"stream","name":"stderr","text":["Refining on Validation Data - Epoch 1: 100%|██████████| 125/125 [00:02<00:00, 61.85it/s, loss=0.0061]\n"]},{"output_type":"stream","name":