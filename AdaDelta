weight_decay']\n","\n","            for p in group['params']:\n","                if p.grad is None:\n","                    continue\n","\n","                grad = p.grad.data\n","                if wd != 0:\n","                    grad = grad.add(wd, p.data)\n","\n","                state = self.state[p]\n","                if len(state) == 0:\n","                    state['Eg2'] = torch.zeros_like(p.data)\n","                    state['Edx2'] = torch.zeros_like(p.data)\n","\n","                Eg2, Edx2 = state['Eg2'], state['Edx2']\n","\n","                Eg2.mul_(rho).addcmul_(grad, grad, value=1 - rho)\n","\n","                dx = - (Edx2.add(eps).sqrt() / Eg2.add(eps).sqrt()) * grad\n","\n","                Edx2.mul_(rho).addcmul_(dx, dx, value=1 - rho)\n","\n","                p.data.add_(dx)\n","\n","        return loss"],"metadata":{"papermill":{"duration":0.032868,"end_time":"2021-04-28T20:52:08.185517","exception":false,"start_time":"2021-04-28T20:52:08.152649","status":"completed"},"tags":[],"execution":{"iopub.status.busy":"2025-12-11T22:19:16.510886Z","iopub.execute_input":"2025-12-11T22:19:16.511421Z","iopub.status.idle":"2025-12-11T22:19:16.519427Z","shell.execute_reply.started":"2025-12-11T22:19:16.511398Z","shell.execute_reply":"2025-12-11T22:19:16.518729Z"},"trusted":true,"id":"_hfRcjT7iAxz","executionInfo":{"status":"ok","timestamp":1766262588214,"user_tz":360,"elapsed":1,"user":{"displayName":"Roman Hunter","userId":"04599973894551074078"}}},"outputs":[],"execution_count":14},{"cell_type":"markdown","source":["## Final project: add a schedular"],"metadata":{"id":"7Ue0rgvkiAxz"}},{"cell_type":"markdown","source":["# Training"],"metadata":{"papermill":{"duration":0.019811,"end_time":"2021-04-28T20:52:08.225432","exception":false,"start_time":"2021-04-28T20:52:08.205621","status":"completed"},"tags":[],"id":"Uh7lY2VZiAxz"}},{"cell_type":"code","source":["device = torch.device('cuda' if torch.cuda.is_available() else 'cpu')\n","print(device) # s