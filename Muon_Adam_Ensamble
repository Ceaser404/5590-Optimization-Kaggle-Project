"code","source":["from tqdm.auto import tqdm\n","\n","# --- ENSEMBLE HYPERPARAMETERS ---\n","adam_lr = 5e-5        # Adam usually likes smaller LRs than Muon\n","muon_lr = 1e-3        # Muon's spectral norm LR\n","k_interval = 30        # Sync every 5 steps\n","ns_steps = 5          # Newton-Schulz iterations\n","# --------------------------------\n","\n","# 1. Initialize the Ensemble Optimizer\n","# We pass both sets of hyperparameters\n","optimizer = MuonAdamLookahead(\n","    model.parameters(),\n","    adam_lr=adam_lr,\n","    muon_lr=muon_lr,\n","    betas=(0.9, 0.99), # Adam betas\n","    muon_beta=0.9,    # Muon momentum\n","    k=k_interval,\n","    ns_steps=ns_steps,\n","    weight_decay=0.01  # Standard AdamW style decay\n",")\n","\n","# 2. Scheduler\n","# Note: ReduceLROnPlateau looks for 'lr' in param_groups by default.\n","# Because we used 'adam_lr' and 'muon_lr', we need to tell the scheduler which to watch.\n","scheduler = torch.optim.lr_scheduler.ReduceLROnPlateau(\n","    optimizer,\n","    mode='min', # Usually 'min' for loss, 'max' for accuracy\n","    factor=0.5,\n","    patience=2\n",")\n","\n","# Important: Patch the optimizer so the scheduler finds a 'lr' key\n","# This prevents ReduceLROnPlateau from throwing an error.\n","for group in optimizer.param_groups:\n","    group['lr'] = group['adam_lr']\n","\n","loss_func = torch.nn.CrossEntropyLoss()\n","model.to(device);"],"metadata":{"papermill":{"duration":4.000081,"end_time":"2021-04-28T20:52:12.880808","exception":false,"start_time":"2021-04-28T20:52:08.880727","status":"completed"},"tags":[],"execution":{"iopub.status.busy":"2025-12-11T22:21:03.143362Z","iopub.execute_input":"2025-12-11T22:21:03.143677Z","iopub.status.idle":"2025-12-11T22:21:03.150076Z","shell.execute_reply.started":"2025-12-11T22:21:03.143657Z","shell.execute_reply":"2025-12-11T22:21:03.149446Z"},"trusted":true,"id":"PrXVMD4oiAxz","executionInfo":{"status":"aborted","timestamp":1766277366300,"user_tz":360,"elapsed":138031,