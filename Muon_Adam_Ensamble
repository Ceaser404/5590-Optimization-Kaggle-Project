yond the point where the iteration no longer converges all the way to one everywhere\n","    on the interval. This iteration therefore does not produce UV^T but rather something like US'V^T\n","    where S' is diagonal with S_{ii}' ~ Uniform(0.5, 1.5), which turns out not to hurt model\n","    performance at all relative to UV^T, where USV^T = G is the SVD.\n","    \"\"\"\n","    assert G.ndim >= 2 # batched Muon implementation by @scottjmaddox, and put into practice in the record by @YouJiacheng\n","    a, b, c = (3.4445, -4.7750,  2.0315)\n","    X = G.bfloat16()\n","    if G.size(-2) > G.size(-1):\n","        X = X.mT\n","\n","    # Ensure spectral norm is at most 1\n","    X = X / (X.norm(dim=(-2, -1), keepdim=True) + 1e-7)\n","    # Perform the NS iterations\n","    for _ in range(steps):\n","        A = X @ X.mT\n","        B = b * A + c * A @ A # quintic computation strategy adapted from suggestion by @jxbz, @leloykun, and @YouJiacheng\n","        X = a * X + B @ X\n","\n","    if G.size(-2) > G.size(-1):\n","        X = X.mT\n","    return X"],"metadata":{"id":"D0IJFIFVLroN","executionInfo":{"status":"aborted","timestamp":1766277366289,"user_tz":360,"elapsed":138022,"user":{"displayName":"Roman Hunter","userId":"04599973894551074078"}}},"execution_count":null,"outputs":[]},{"cell_type":"markdown","source":["# Final project: write our own optimizer\n","\n","In the following cells, we use the `torch.optim` interface to build our own optimizer.\n","The following code is simplified from an early version of [SGD in PyTorch 1.x](https://docs.pytorch.org/docs/1.9.0/optim.html?highlight=sgd#torch.optim.SGD)\n","\n","Please refer to the final project page to see requirements of the implementation of a customized optimizer."],"metadata":{"papermill":{"duration":0.021728,"end_time":"2021-04-28T20:52:08.085228","exception":false,"start_time":"2021-04-28T20:52:08.0635","status":"completed"},"tags":[],"id":"kFmIMHGOiAxz"}},{"cell_type":"code","source":["import torch\n","from torch.optim import Optimizer\n","import math\n","\n","def zeropower_via_newtonschulz5(G, steps=5):\n","    \"\"\"\n","    Standard Muon Newton-Schulz iteration to orthogonalize updates.\n","    \"\"\"\n","    assert len(G.shape) == 2\n","    a, b, c = (3.4445, -4.7750,  2.0315)\n","    X = G.bfloat16() if G.dtype == torch.float32 else G\n","\n","    # Scale to prevent overflow/underflow\n","    X = X / (X.norm() + 1e-7)\n","    if G.size(0) > G.size(1):\n","        X = X.T\n","\n","    for _ in range(steps):\n","        A = X @ X.T\n","        B = A @ X\n","        X = a * X + b * B + c * A @ B\n","\n","    return X if G.size(0) <= G.size(1) else X.T\n","\n","class MuonAdamLookahead(Optimizer):\n","    def __init__(self, params, adam_lr=1e-3, muon_lr=0.02, betas=(0.9, 0.999),\n","                 muon_beta=0.95, k=5, ns_steps=5, eps=1e-8, weight_decay=0.0):\n","\n","        # We add 'lr' here so ReduceLROnPlateau doesn't crash.\n","        # We'll use it as a reference for the Adam learning rate.\n","        defaults = dict(lr=adam_lr, adam_lr=adam_lr, muon_lr=muon_lr, betas=betas,\n","                        muon_beta=muon_beta, k=k, ns_steps=ns_steps,\n","                        eps=eps, weight_decay=weight_decay)\n","        super().__init__(params, defaults)\n","\n","    def step(self, closure=None):\n","        loss = None\n","        for group in self.param_groups:\n","            for p in group['params']:\n","                if p.grad is None:\n","                    continue\n","\n","                grad = p.grad\n","                state = self.state[p]\n","\n","                # --- State Initialization ---\n","                if len(state) == 0:\n","                    state['step'] = 0\n","                    state['exp_avg'] = torch.zeros_like(p)     # Adam Momentum\n","                    state['exp_avg_sq'] = torch.zeros_like(p)  # Adam Variance\n","                    state['muon_buf'] = torch.zeros_like(p)    # Muon Momentum\n","\n","                state['step'] += 1\n","                k = group['k']\n","\n","                # --- FAST PATH: Adam Step ---\n","                exp_avg, exp_avg_sq = state['exp_avg'], state['exp_avg_sq']\n","                beta1, beta2 = group['betas']\n","\n","                exp_avg.mul_(beta1).add_(grad, alpha=1 - beta1)\n","                exp_avg_sq.mul_(beta2).addcmul_(grad, grad, value=1 - beta2)\n","\n","                denom = exp_avg_sq.sqrt().add_(group['eps'])\n","                bias_correction1 = 1 - beta1**state['step']\n","                bias_correction2 = 1 - beta2**state['step']\n","                step_size = group['adam_lr'] * math.sqrt(bias_correction2) / bias_correction1\n","\n","                # Apply Adam update\n","                p.data.addcdiv_(exp_avg, denom, value=-step_size)\n","\n","                # --- SLOW PATH: Muon Orthogonalization (Every k steps) ---\n","                # Only apply to 2D weights (Hidden layers)\n","                if state['step'] % k == 0 and p.ndim >= 2:\n","                    muon_beta = group['muon_beta']\n","                    muon_buf = state['muon_buf']\n","\n","                    # 1. Update Muon momentum with the current gradient\n","                    muon_buf.lerp_(grad, 1 - muon_beta)\n","\n","                    # 2. Nesterov-style momentum update for Muon\n","                    update = grad.lerp_(muon_buf, muon_beta)\n","\n","                    # 3. Handle Conv layers by flattening\n","                    original_shape = update.shape\n","                    if update.ndim == 4:\n","                        update = update.view(len(update), -1)\n","\n","                    # 4. Perform Newton-Schulz Orthogonalization\n","                    update = zeropower_via_newtonschulz5(update, steps=group['ns_steps'])\n","\n","                    # 5. Scale and apply the Muon \"correction\"\n","                    # This pulls the Adam-driven weights back toward an orthogonal manifold\n","                    update *= max(1, update.size(-2) / update.size(-1))**0.5\n","\n","                    with torch.no_grad():\n","                        p.add_(update.reshape(original_shape), alpha=-group['muon_lr'])\n","\n","        return loss"],"metadata":{"papermill":{"duration":0.032868,"end_time":"2021-04-28T20:52:08.185517","exception":false,"start_time":"2021-04-28T20:52:08.152649","status":"completed"},"tags":[],"execution":{"iopub.status.busy":"2025-12-11T22:19:16.510886Z","iopub.execute_input":"2025-12-11T22:19:16.511421Z","iopub.status.idle":"2025-12-11T22:19:16.519427Z","shell.execute_reply.started":"2025-12-11T22:19:16.511398Z","shell.execute_reply":"2025-12-11T22:19:16.518729Z"},"trusted":true,"id":"_hfRcjT7iAxz","executionInfo":{"status":"aborted","timestamp":1766277366293,"user_tz":360,"elapsed":138026,"user":{"displayName":"Roman Hunter","userId":"04599973894551074078"}}},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":["## Final project: add a schedular"],"metadata":{"id":"7Ue0rgvkiAxz"}},{"cell_type":"code","source":["from torch.optim.lr_scheduler import ReduceLROnPlateau, _LRScheduler\n","\n","class MinimalScheduler(_LRScheduler):\n","    def __init__(self,\n","                 optimizer,\n","                 last_epoch=-1):\n","        \"\"\"\n","        Implements a minimal learning rate scheduler\n","        \"\"\"\n","        super().__init__(optimizer, last_epoch)\n","\n","    def get_lr(self):\n","        # Implement your logic here to return a list of learning rates for each param group\n","        # Example: return [group['lr'] * 0.9 for group in self.optimizer.param_groups]\n","        return [group['lr'] for group in self.optimizer.param_groups]\n","\n","\n","from torch.optim.lr_scheduler import _LRScheduler\n","\n","class MinimalScheduler(_LRScheduler):\n","    def __init__(self, optimizer, last_epoch=-1):\n","        super().__init__(optimizer, last_epoch)\n","\n","    def get_lr(self):\n","        # We return the Adam LRs as