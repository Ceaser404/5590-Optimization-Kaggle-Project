in train_loader:\n","            x, targets = x.to(device), targets.to(device)\n","\n","            outputs = model(x)\n","            loss = loss_func(outputs, targets)\n","\n","            optimizer.zero_grad()\n","            loss.backward()\n","            optimizer.step()\n","\n","            # Record metrics\n","            loss_vals.append(loss.item())\n","            with torch.no_grad():\n","                preds = outputs.argmax(dim=-1)\n","                batch_acc = (preds == targets).float().mean().item()\n","                train_acc_accum.append(batch_acc)\n","\n","            pbar.set_postfix({\n","                'loss': f\"{np.mean(loss_vals):.4f}\",\n","                'tr_acc': f\"{np.mean(train_acc_accum):.4f}\"\n","            })\n","            pbar.update()\n","\n","    # Calculate Epoch Averages\n","    avg_train_loss = np.mean(loss_vals)\n","    avg_train_acc = np.mean(train_acc_accum)\n","    train_losses.append(avg_train_loss)\n","    train_accs.append(avg_train_acc)\n","\n","    # --- VALIDATION PHASE ---\n","    model.eval()\n","    val_loss_epoch = []  # Properly separated initialization\n","    acc_on_valid = []    # Properly separated initialization\n","\n","    with torch.no_grad():\n","        for x_v, y_v in val_loader:\n","            x_v, y_v = x_v.to(device), y_v.to(device)\n","            yhat = model(x_v)\n","            v_loss = loss_func(yhat, y_v)\n","            val_loss_epoch.append(v_loss.item())\n","\n","            preds_v = yhat.argmax(dim=-1)\n","            acc_v = (preds_v == y_v).float().mean().item()\n","            acc_on_valid.append(acc_v)\n","\n","    avg_val_loss = np.mean(val_loss_epoch)\n","    avg_val_acc = np.mean(acc_on_valid)\n","    val_losses.append(avg_val_loss)\n","    val_accs.append(avg_val_acc)\n","\n","    # --- POST-EPOCH LOGGING & SCHEDULER ---\n","    print(f\"\\nSummary Epoch {epoch+1}:\")\n","    print(f\"Train Loss: {avg_train_loss:.4e} | Train Acc: {avg_train_acc:.4f}\")\n","    print(f