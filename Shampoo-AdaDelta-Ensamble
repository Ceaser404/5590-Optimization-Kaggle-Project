 own optimizer.\n","The following code is simplified from an early version of [SGD in PyTorch 1.x](https://docs.pytorch.org/docs/1.9.0/optim.html?highlight=sgd#torch.optim.SGD)\n","\n","Please refer to the final project page to see requirements of the implementation of a customized optimizer."],"metadata":{"papermill":{"duration":0.021728,"end_time":"2021-04-28T20:52:08.085228","exception":false,"start_time":"2021-04-28T20:52:08.0635","status":"completed"},"tags":[],"id":"kFmIMHGOiAxz"}},{"cell_type":"code","source":["import torch\n","from torch.optim import Optimizer\n","\n","class ShampooAdaDeltaW(Optimizer):\n","    def __init__(self, params, lr=1.0, rho=0.99, eps=1e-6, weight_decay=0.01,\n","                 k=30, shampoo_beta=0.9, epsilon_shampoo=1e-4):\n","        # k: how often to recompute the inverse square root (expensive)\n","        defaults = dict(lr=lr, rho=rho, eps=eps, weight_decay=weight_decay,\n","                        k=k, shampoo_beta=shampoo_beta, epsilon_shampoo=epsilon_shampoo)\n","        super().__init__(params, defaults)\n","        self.fast_mag = 0.0\n","        self.precond_mag = 0.0\n","\n","    @torch.no_grad()\n","    def step(self, closure=None):\n","        loss = None\n","        if closure is not None:\n","            with torch.enable_grad(): loss = closure()\n","\n","        total_fast = 0.0\n","        total_precond = 0.0\n","        count = 0\n","\n","        for group in self.param_groups:\n","            for p in group['params']:\n","                if p.grad is None: continue\n","                grad = p.grad\n","                state = self.state[p]\n","\n","                # State initialization\n","                if len(state) == 0:\n","                    state['step'] = 0\n","                    state['sq_avg'] = torch.zeros_like(p)   # AdaDelta denominator\n","                    state['acc_upd'] = torch.zeros_like(p)  # AdaDelta numerator\n","\n","                    # Shampoo preconditioners (L and R for 2D weights)\n","                    # For a weight (M, N), L is (M, M) and R is (N, N)\n","                    dim_l, dim_r = grad.size(0), grad.size(1) if grad.ndim > 1 else 1\n","                    state['precond_L'] = torch.eye(dim_l, device=p.device) * group['epsilon_shampoo']\n","                    if grad.ndim > 1:\n","                        state['precond_R'] = torch.eye(dim_r, device=p.device) * group['epsilon_shampoo']\n","\n","                    state['inv_L'] = torch.eye(dim_l, device=p.device)\n","                    if grad.ndim > 1:\n","                        state['inv_R'] = torch.eye(dim_r, device=p.device)\n","\n","                state['step'] += 1\n","                rho, eps = group['rho'], group['eps']\n","\n","                # 1. Decoupled Weight Decay\n","                if group['weight_decay'] != 0:\n","                    p.data.mul_(1 - group['lr'] * group['weight_decay'])\n","\n","                # 2. Shampoo Preconditioning Step\n","                # Update Kronecker factors\n","                if grad.ndim == 2:\n","                    state['precond_L'].mul_(group['shampoo_beta']).addmm_(grad, grad.t(), alpha=1-group['shampoo_beta'])\n","                    state['precond_R'].mul_(group['shampoo_beta']).addmm_(grad.t(), grad, alpha=1-group['shampoo_beta'])\n","\n","                    # Periodically recompute matrix inverse square roots\n","                    if state['step'] % group['k'] == 0:\n","                        state['inv_L'] = self._matrix_pow(state['precond_L'], -0.25)\n","                        state['inv_R'] = self._matrix_pow(state['precond_R'], -0.25)\n","\n","                    # Apply preconditioning: grad = L^{-1/4} * grad * R^{-1/4}\n","                    grad_precond = state['inv_L'] @ grad @ state['inv_R']\n","                else:\n","                    grad_precond = grad # Fallback for 1D vectors\n","\n","                # 3. AdaDelta Step (using Preconditioned Gradient)\n","                state['sq_avg'].mul_(rho).addcmul_(grad_precond, grad_precond, value=1 - rho)\n","\n","                std_grads = state['sq_avg'].add(eps).sqrt()\n","                std_deltas = state['acc_upd'].add(eps).sqrt()\n","\n","                update = grad_precond.mul(std_deltas).div(std_grads).mul(group['lr'])\n","                p.data.add_(update, alpha=-1.0)\n","\n","                state['acc_upd'].mul_(rho).addcmul_(update, update, value=1 - rho)\n","\n","                total_fast += update.norm(2).item()\n","                count += 1\n","\n","        self.fast_mag = total_fast / count if count > 0 else 0\n","        return loss\n","\n","    def _matrix_pow(self, matrix, power):\n","        \"\"\"Helper to compute matrix power via Eigen decomposition.\"\"\"\n","        evals, evecs = torch.linalg.eigh(matrix)\n","        # Clamp evals to avoid negatives due to precision\n","        return evecs @ torch.diag(evals.clamp(min=1e-12).pow(power)) @ evecs.t()"],"metadata":{"papermill":{"duration":0.032868,"end_time":"2021-04-28T20:52:08.185517","exception":false,"start_time":"2021-04-28T20:52:08.152649","status":"completed"},"tags":[],"execution":{"iopub.status.busy":"2025-12-11T22:19:16.510886Z","iopub.execute_input":"2025-12-11T22:19:16.511421Z","iopub.status.idle":"2025-12-11T22:19:16.519427Z","shell.execute_reply.started":"2025-12-11T22:19:16.511398Z","shell.execute_reply":"2025-12-11T22:19:16.518729Z"},"trusted":true,"id":"_hfRcjT7iAxz","executionInfo":{"status":"ok","timestamp":1766278686069,"user_tz":360,"elapsed":44,"user":{"displayName":"Roman Hunter","userId":"04599973894551074078"}}},"outputs":[],"execution_count":14},{"cell_type":"markdown","source":["## Final project: add a schedular"],"metadata":{"id":"7Ue0rgvkiAxz"}},{"cell_type":"code","source":["from torch.optim.lr_scheduler import _LRScheduler\n","\n","class ShampooAdaDeltaScheduler(_LRScheduler):\n","    def __init__(self, optimizer, last_epoch=-1):\n","        # Store the initial learning rate values\n","        super().__init__(optimizer, last_epoch)\n","\n","    def get_lr(self):\n","        \"\"\"\n","        Returns the current AdaDelta global coefficients.\n","        \"\"\"\n","        return [group['lr'] for group in self.optimizer.param_groups]\n","\n","    def step_lr(self, factor=0.5):\n","        \"\"\"\n","        Scales the AdaDelta global coefficient.\n","        In Shampoo-AdaDelta, this 'lr' acts as the final 'step size'\n","        after the gradient has been preconditioned by Shampoo.\n","        \"\"\"\n","        for group in self.optimizer.param_groups:\n","            # 1. Scale the global multiplier\n","            group['lr'] *= factor\n","\n","            # Optional: You could also scale 'weight_decay' here if you\n","            # want the regularization to weaken as steps get smaller.\n","            # group['weight_decay'] *= factor\n","\n","            print(f\"--- Scheduler Triggered ---\")\n","            print(f\"Decayed AdaDelta Coeff -> {group['lr']:.3e}\")\n","\n","            # If the coefficient gets extremely low, we stop Shampoo's\n","            # heavy matrix inversions to save compute during fine-tuning.\n","            if group['lr'] < 0.1:\n","                # We can essentially \"freeze\" the Shampoo preconditioner\n","                # by setting k to a massive number.\n","                group['k'] = 1_000_000\n","                print(\"Note: Step size low. Shampoo preconditioner frozen for final convergence.\")"],"metadata":{"trusted":true,"execution":{"iopub.status.busy":"2025-12-11T22:20:11.686879Z","iopub.execute_input":"2025-12-11T22:20:11.687617Z","iopub.status.idle":"2025-12-11T22:20:11.693676Z","shell.execute_reply.started":"2025-12-11T22:20:11.687581Z","shell.execute_reply":"2025-12-11T22:20:11.692855Z"},"id":"OENi5hp3iAxz","executionInfo":{"status":"ok","timestamp":1766278686077,"user_tz":360,"elapsed":42,"user":{"displayName":"Roman Hunter","userId":"04599973894551074078"}}},"outputs":[],"execution_count":15},{"cell_