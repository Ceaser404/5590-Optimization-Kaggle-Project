ault: 0)\n","\n","    Example:\n","        >>> optimizer = SGD(model.parameters(), lr=1e-2)\n","        >>> optimizer.zero_grad()\n","        >>> loss_fn(model(input), target).backward()\n","        >>> optimizer.step()\n","    \"\"\"\n","\n","    def __init__(self, params,\n","                      lr=1e-3,\n","                      momentum=0.9,\n","                      weight_decay=0,):\n","        defaults = dict(lr=lr,\n","                        momentum=momentum,weight_decay=weight_decay)\n","        super(SGD, self).__init__(params, defaults)\n","\n","    def step(self, closure=None):\n","        V = [];\n","        for group in self.param_groups:\n","            weight_decay = group['weight_decay']\n","\n","            for param in group['params']:\n","                if param.grad is None:\n","                    continue\n","                state = self.state[param]\n","                if 'momentum_buffer' not in state:\n","                        state['momentum_buffer'] = torch.zeros_like(param.data)\n","                V = state['momentum_buffer']\n","\n","                grad_param = param.grad.data\n","\n","                if weight_decay != 0:\n","                    grad_param += weight_decay*param.data\n","                V = V*group['momentum'] + (1-group['momentum'])*grad_param\n","\n","                param.data -= group['lr']*grad_param\n","\n","        return loss"],"metadata":{"papermill":{"duration":0.028604,"end_time":"2021-03-24T02:13:28.745753","exception":false,"start_time":"2021-03-24T02:13:28.717149","status":"completed"},"tags":[],"execution":{"iopub.status.busy":"2025-11-13T21:35:52.709925Z","iopub.execute_input":"2025-11-13T21:35:52.710578Z","iopub.status.idle":"2025-11-13T21:35:52.716838Z","shell.execute_reply.started":"2025-11-13T21:35:52.71055Z","shell.execute_reply":"2025-11-13T21:35:52.716014Z"},"trusted":true,"id":"q9CHMS4InTnv","executionInfo":{"status":"ok","timestamp":1765949484947,"user_tz":360,"elapsed":8,"user":{"displ